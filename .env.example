ADMIN_SEED_EMAIL=YOUR_VALUE_HERE
ADMIN_SEED_PASSWORD=YOUR_VALUE_HERE
ADMIN_SEED_PHONE=YOUR_VALUE_HERE

# =========================================================
# REDIS (if used)
