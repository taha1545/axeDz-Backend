# =========================================================
# APP
# =========================================================
APP_NAME=YOUR_VALUE_HERE
NODE_ENV=YOUR_VALUE_HERE
LOG_LEVEL=YOUR_VALUE_HERE
APP_PORT=YOUR_VALUE_HERE
API_PREFIX=YOUR_VALUE_HERE
APP_VERSION=YOUR_VALUE_HERE

# =========================================================
# COSTS
# =========================================================
SMS_COST=YOUR_VALUE_HERE
EMAIL_COST=YOUR_VALUE_HERE

# =========================================================
# DATABASE
# =========================================================
DB_HOST=YOUR_VALUE_HERE
DB_PORT=YOUR_VALUE_HERE
DB_NAME=YOUR_VALUE_HERE
DB_USER=YOUR_VALUE_HERE
DB_PASSWORD=YOUR_VALUE_HERE

# =========================================================
# JWT
# =========================================================
JWT_SECRET=YOUR_VALUE_HERE
JWT_LIFETIME=15m
JWT_REFRESH_SECRET=YOUR_VALUE_HERE
JWT_REFRESH_LIFETIME=30d
REFRESH_COOKIE_MAX_AGE_MS=2592000000

# =========================================================
# OTP
# =========================================================
OTP_EXP_MINUTES=15
OTP_MAX_ATTEMPTS=3

# =========================================================
# SECURITY
# =========================================================
CORS_ALLOWLIST=http://localhost:3000,http://localhost:5173
CORS_ALLOW_ALL=false
CORS_CREDENTIALS=true
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
BRUTE_FORCE_DELAY_AFTER=5
BRUTE_FORCE_DELAY_MS=500
BRUTE_FORCE_MAX_DELAY_MS=5000
BCRYPT_ROUNDS=10

# =========================================================
# MAIL
# =========================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=YOUR_VALUE_HERE
MAIL_PASS=YOUR_VALUE_HERE
MAIL_ENCRYPTION=ssl

# =========================================================
# GOOGLE AUTH
# =========================================================
GOOGLE_CLIENT_ID=YOUR_VALUE_HERE
GOOGLE_CLIENT_SECRET=YOUR_VALUE_HERE
SESSION_SECRET=YOUR_VALUE_HERE
GOOGLE_CALLBACK_URL=YOUR_VALUE_HERE
FRONT_URL_CALLBACK=YOUR_VALUE_HERE

# =========================================================
# AWS S3
# =========================================================
AWS_ACCESS_KEY_ID=YOUR_VALUE_HERE
AWS_SECRET_ACCESS_KEY=YOUR_VALUE_HERE
AWS_DEFAULT_REGION=eu-central-003
AWS_BUCKET=YOUR_VALUE_HERE
AWS_ENDPOINT=YOUR_VALUE_HERE

# =========================================================
# RABBITMQ
# =========================================================
RABBITMQ_URL=amqp://user:password@localhost:5672

# =========================================================
# SMS
# =========================================================
SMS_PROVIDER=ooredoo
SMS_PROVIDER_URL=YOUR_VALUE_HERE
SMS_PROVIDER_KEY=YOUR_VALUE_HERE
SMS_FROM_NUMBER=AxeDz

# =========================================================
# PAYMENT (SATIM)
# =========================================================
SATIM_USERNAME=YOUR_VALUE_HERE
SATIM_PASSWORD=YOUR_VALUE_HERE
SATIM_TERMINAL_ID=YOUR_VALUE_HERE
SATIM_SANDBOX=true
SATIM_RETURN_URL=YOUR_VALUE_HERE
SATIM_FAIL_URL=YOUR_VALUE_HERE

# =========================================================
# ADMIN SEEDS (optional)
